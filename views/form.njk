{% extends "layout.njk" %}

{% block title %}{{ tituloPagina }} - GameVault{% endblock %}

{% block content %}
  <h1>{{ tituloPagina }}</h1>

  <form action="{{ accion }}" method="POST" class="form-card">
    <label>
      Título
      <input type="text" name="titulo" required value="{{ juego.titulo if juego else '' }}" placeholder="Ej. Silksong" />
    </label>

    <label>
      Estudio
      <input type="text" name="estudio" required value="{{ juego.estudio if juego else '' }}" placeholder="Ej. Team Cherry" />
    </label>

    <label>
      Plataforma
      <input type="text" name="plataforma" required value="{{ juego.plataforma if juego else '' }}" placeholder="Ej. PC / Switch" />
    </label>

    <div class="form-row">
      <label>
        Año
        <input type="number" name="anio" required min="1970" max="2100" value="{{ juego.anio if juego else 2026 }}" />
      </label>

      <label>
        Género
        <input type="text" name="genero" required value="{{ juego.genero if juego else '' }}" placeholder="Ej. Metroidvania" />
      </label>

      <label>
        Nota (0-10)
        <input type="number" name="nota" required min="0" max="10" step="0.5" value="{{ juego.nota if juego else 9 }}" />
      </label>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Guardar</button>
      <a href="/" class="btn btn-secondary">Cancelar</a>
    </div>
  </form>
{% endblock %}
